    alignItems: 'center',
    padding: 18,
    backgroundColor: '#ffffff',
    borderRadius: 16,
    borderWidth: 1,
    borderColor: '#e5e7eb',
    gap: 14,
  },
 
  addIconButton: {
    alignSelf: 'center',
    marginTop: 42,
    width: 68,
    height: 68,
    borderRadius: 34,
    backgroundColor: '#4f46e5',
    alignItems: 'center',
    justifyContent: 'center',
  },
  
  readerContainer: {
    flex: 1,
    padding: 12,
    paddingTop: 48,
    backgroundColor: '#ffffff',
  },
  readerHeader: {
    flexDirection: 'row',
    alignItems: 'center',
    gap: 14,
    marginBottom: 12,
  },
  readerTitle: {
    flex: 1,
    fontSize: 16,
    fontWeight: '600',
    color: '#111827',
  },
  pdfContainer: {
    flex: 1,
    overflow: 'hidden',
    borderRadius: 8,
    backgroundColor: '#e5e7eb',
  },
  pdf: {
    flex: 1,
    width: '100%',
    backgroundColor: '#e5e7eb',
  },
  loading: {
    ...StyleSheet.absoluteFill,
    alignItems: 'center',
    justifyContent: 'center',
    gap: 10,
    backgroundColor: '#ffffffcc',
  },
  pageCounter: {
    textAlign: 'center',
    paddingVertical: 8,
    fontSize: 14,
    color: '#333333',
    backgroundColor: '#f0f0f0',
  },
  emptyBox: {
    marginTop: 35,
    padding: 25,
    borderRadius: 16,
    backgroundColor: '#f3f4f6',
    alignItems: 'center',
  },
  emptyTitle: {
    fontSize: 20,
    fontWeight: '600',
  },
  openButton: {
    marginTop: 18,
    padding: 12,
    backgroundColor: '#4f46e5',
    borderRadius: 10,
  },
  openButtonText: {
    color: '#ffffff',
    fontWeight: '600',
  },
  error: {
    marginTop: 12,
    marginBottom: 12,
    color: '#b91c1c',
  },
  recentSection: {
    marginTop: 28,
  },
  recentHeader: {
    flexDirection: 'row',
    alignItems: 'center',
    justifyContent: 'space-between',
    marginBottom: 12,
  },
  recentTitle: {
    fontSize: 19,
    fontWeight: '700',
    color: '#111827',
  },
  seeAll: {
    color: '#4f46e5',
    fontSize: 14,
    fontWeight: '600',
  },
  noRecent: {
    color: '#6b7280',
    fontSize: 14,
    paddingVertical: 16,
  },
  recentItem: {
    flexDirection: 'row',
    alignItems: 'center',
    gap: 12,
    padding: 14,
    marginBottom: 8,
    backgroundColor: '#ffffff',
    borderRadius: 12,
    borderWidth: 1,
    borderColor: '#e5e7eb',
  },
  recentItemText: {
    flex: 1,
  },
  recentFileName: {
    fontSize: 14,
    fontWeight: '600',
    color: '#111827',
  },
  recentDate: {
    marginTop: 4,
    fontSize: 12,
    color: '#6b7280',
  },

  officeViewer: {
    flex: 1,
    overflow: 'hidden',
    borderRadius: 8,
    backgroundColor: '#ffffff',
  },

  imageViewer: {
    flex: 1,
    backgroundColor: '#f3f4f6',
    justifyContent: 'center',
  },

  imageScrollContent: {
    flexGrow: 1,
    justifyContent: 'center',
    alignItems: 'center',
